+// LOCAL ADDITION: scripted input and a controllable clock.
+//
+// WHAT THIS IS FOR. The event recorder is two useful mechanisms welded to an oracle we cannot
+// use. The mechanisms: pollEvent() feeds events straight into the engine's own pipeline (no X
+// server, no window focus, no dropped keystroke), and processMillis() owns the engine's clock.
+// The oracle: a screenshot MD5 compared against a recorded tape -- which asks "is this the same
+// as last time", a REGRESSION question. This project needs the CONFORMANCE question: does the
+// game behave the way the spec derived from the emitted patch source says it must. A tape cannot
+// answer that, because a tape recorded while a guard was broken passes forever.
+//
+// So: keep the transport, drop the tape. A run is described by a short text script, authored
+// from the site table, and the verdict is read elsewhere (the SCI console: `has:`, a warn bit,
+// the printed sentence).
+//
+// THE CLOCK. _fakeTimer advances by _clockStep for every getMillis() the engine performs, and by
+// nothing else. Two consequences, both wanted:
+//
+//   * Determinism. The same script over the same game produces the same virtual times, whatever
+//     the machine is doing.
+//   * The clock can never be starved. Every game-side wait -- a modal print's timeout, a speech
+//     wait, the engine's own speed throttle -- is a loop that queries the time, so every such
+//     loop terminates in a bounded number of queries. That is the exact failure that made the
+//     text-console build unable to finish an interaction: it parked forever at a print because
+//     the real clock was stopped while the debugger held stdin. Here the clock is driven by the
+//     engine asking, not by the wall, so a blocked debugger cannot freeze it.
+//
+// Audio rides along: the recorder's NullMixerManager is pumped from the same place, so a
+// wait-for-speech advances too, without an audio device.
+//
+// SCRIPT FORMAT -- one step per line, `#` starts a comment.
+//
+//     clock 10                 ms of virtual time per getMillis() query (before the run starts)
+//     t=1200 click 141 124     move, press, release _clickHold ms later
+//     t=+400 rclick 141 124    the same with the right button
+//     t=+0   move 10 20        a bare mouse move
+//     t=+100 down 10 20        press without releasing  (`up` is the other half)
+//     t=+250 key escape        keydown + keyup; a single character is that character
+//     t=2000 clock 1           change the clock rate mid-run
+//     t=2500 mark offered      print "[script] t=2500 mark offered" on stdout
+//     t=3000 break             hand control to the engine's debugger at a known virtual time
+//     t=9000 quit              end the run (a script that never quits never terminates)
+//
+// `t=+N` is relative to the previous step. Steps must be in time order; the parser rejects a
+// script that is not, rather than silently reordering it.
+// ---------------------------------------------------------------------------------------------
+
+static bool parseKeyName(const Common::String &name, Common::KeyState &out) {
+	struct { const char *name; Common::KeyCode code; uint16 ascii; } kNamedKeys[] = {
+		{ "escape",    Common::KEYCODE_ESCAPE,    27   },
+		{ "esc",       Common::KEYCODE_ESCAPE,    27   },
+		{ "return",    Common::KEYCODE_RETURN,    13   },
+		{ "enter",     Common::KEYCODE_RETURN,    13   },
+		{ "space",     Common::KEYCODE_SPACE,     ' '  },
+		{ "tab",       Common::KEYCODE_TAB,       9    },
+		{ "backspace", Common::KEYCODE_BACKSPACE, 8    },
+		{ "up",        Common::KEYCODE_UP,        0    },
+		{ "down",      Common::KEYCODE_DOWN,      0    },
+		{ "left",      Common::KEYCODE_LEFT,      0    },
+		{ "right",     Common::KEYCODE_RIGHT,     0    },
+		{ "f1",        Common::KEYCODE_F1,        0    },
+		{ "f2",        Common::KEYCODE_F2,        0    },
+		{ "f3",        Common::KEYCODE_F3,        0    },
+		{ "f4",        Common::KEYCODE_F4,        0    },
+		{ "f5",        Common::KEYCODE_F5,        0    },
+		{ "f6",        Common::KEYCODE_F6,        0    },
+		{ "f7",        Common::KEYCODE_F7,        0    },
+		{ "f8",        Common::KEYCODE_F8,        0    },
+		{ "f9",        Common::KEYCODE_F9,        0    },
+		{ "f10",       Common::KEYCODE_F10,       0    }
+	};
+
+	Common::String lower(name);
+	lower.toLowercase();
+	for (uint i = 0; i < ARRAYSIZE(kNamedKeys); i++) {
+		if (lower == kNamedKeys[i].name) {
+			out = Common::KeyState(kNamedKeys[i].code, kNamedKeys[i].ascii);
+			return true;
+		}
+	}
+	if (name.size() == 1) {
+		// A single printable character stands for itself. SCI reads the ascii field, so both
+		// have to be right; the keycode of an ASCII letter IS its lowercase code point.
+		char c = name[0];
+		Common::KeyCode code = (Common::KeyCode)(c >= 'A' && c <= 'Z' ? c - 'A' + 'a' : c);
+		out = Common::KeyState(code, (uint16)(byte)c);
+		return true;
+	}
+	return false;
+}
+
+// `origin` is where this batch's t=0 sits on the virtual clock -- 0 for a script given on the
+// command line, the clock as it stands for one loaded or added live from the debugger, so the
+// same file means the same thing in both places. `lastTime` threads the previous step's absolute
+// time through, which is what `t=+N` is relative to.
+bool EventRecorder::parseScriptLine(const Common::String &line, int lineNo, uint32 origin, uint32 &lastTime) {
+	Common::String work(line);
+	uint32 hash = work.findFirstOf('#');
+	if (hash != Common::String::npos)
+		work.erase(hash);
+	work.trim();
+	if (work.empty())
+		return true;
+
+	Common::StringTokenizer tok(work, " \t");
+	Common::String first = tok.nextToken();
+
+	uint32 when = lastTime;
+	if (first.hasPrefix("t=")) {
+		Common::String t = Common::String(first.c_str() + 2);
+		if (t.hasPrefix("+"))
+			when = lastTime + (uint32)atoi(t.c_str() + 1);
+		else
+			when = origin + (uint32)atoi(t.c_str());
+		if (when < lastTime) {
+			warning("script line %d: t=%u goes backwards (previous step was at %u)", lineNo, when, lastTime);
+			return false;
+		}
+		first = tok.nextToken();
+	}
+	lastTime = when;
+
+	Common::String verb(first);
+	verb.toLowercase();
+
+	ScriptStep step;
+	step.time = when;
+	step.value = 0;
+
+	// The non-event steps first.
+	if (verb == "clock") {
+		Common::String arg = tok.nextToken();
+		if (arg.empty()) {
+			warning("script line %d: `clock` wants a step in milliseconds", lineNo);
+			return false;
+		}
+		step.kind = ScriptStep::kStepClock;
+		step.value = (uint32)atoi(arg.c_str());
+		if (step.value == 0) {
+			warning("script line %d: a clock step of 0 would stop time", lineNo);
+			return false;
+		}
+		_scriptSteps.push_back(step);
+		return true;
+	}
+	if (verb == "mark") {
+		step.kind = ScriptStep::kStepMark;
+		step.text = tok.nextToken();
+		while (!tok.empty())
+			step.text += " " + tok.nextToken();
+		_scriptSteps.push_back(step);
+		return true;
+	}
+	if (verb == "break") {
+		step.kind = ScriptStep::kStepBreak;
+		_scriptSteps.push_back(step);
+		return true;
+	}
+	if (verb == "quit") {
+		step.kind = ScriptStep::kStepQuit;
+		_scriptSteps.push_back(step);
+		return true;
+	}
+
+	// ...and the ones that turn into engine events.
+	step.kind = ScriptStep::kStepEvent;
+	step.event = Common::Event();
+
+	if (verb == "key") {
+		Common::String arg = tok.nextToken();
+		Common::KeyState ks;
+		if (arg.empty() || !parseKeyName(arg, ks)) {
+			warning("script line %d: `key` wants a character or a known key name, got \"%s\"", lineNo, arg.c_str());
+			return false;
+		}
+		step.event.type = Common::EVENT_KEYDOWN;
+		step.event.kbd = ks;
+		_scriptSteps.push_back(step);
+		step.event.type = Common::EVENT_KEYUP;
+		_scriptSteps.push_back(step);
+		return true;
+	}
+
+	bool isClick  = (verb == "click"  || verb == "rclick");
+	bool isDown   = (verb == "down"   || verb == "rdown");
+	bool isUp     = (verb == "up"     || verb == "rup");
+	bool isMove   = (verb == "move");
+	bool isRight  = verb.hasPrefix("r");
+
+	if (!isClick && !isDown && !isUp && !isMove) {
+		warning("script line %d: unknown step \"%s\"", lineNo, verb.c_str());
+		return false;
+	}
+
+	Common::String xs = tok.nextToken();
+	Common::String ys = tok.nextToken();
+	if (xs.empty() || ys.empty()) {
+		warning("script line %d: `%s` wants an x and a y", lineNo, verb.c_str());
+		return false;
+	}
+	step.event.mouse = Common::Point((int16)atoi(xs.c_str()), (int16)atoi(ys.c_str()));
+
+	// Every pointer step starts by moving there, so the engine's idea of the cursor and the
+	// button event agree even when nothing warped it in between.
+	step.event.type = Common::EVENT_MOUSEMOVE;
+	_scriptSteps.push_back(step);
+	if (isMove)
+		return true;
+
+	if (isClick || isDown) {
+		step.event.type = isRight ? Common::EVENT_RBUTTONDOWN : Common::EVENT_LBUTTONDOWN;
+		_scriptSteps.push_back(step);
+	}
+	if (isClick || isUp) {
+		// A press and a release in the same instant is not a click any engine has to notice:
+		// SCI reads one event per game cycle. Hold the button for a beat of virtual time.
+		Common::String holdArg = tok.nextToken();
+		uint32 hold = holdArg.empty() ? kDefaultClickHold : (uint32)atoi(holdArg.c_str());
+		step.time = when + (isClick ? hold : 0);
+		step.event.type = isRight ? Common::EVENT_RBUTTONUP : Common::EVENT_LBUTTONUP;
+		_scriptSteps.push_back(step);
+		lastTime = step.time;
+	}
+	return true;
+}
+
+void EventRecorder::clearScript() {
+	_scriptSteps.clear();
+	_scriptPos = 0;
+}
+
+bool EventRecorder::addScriptStep(const Common::String &line) {
+	uint32 origin = _fakeTimer;
+	uint32 lastTime = origin;
+	uint32 before = _scriptSteps.size();
+	if (!parseScriptLine(line, 0, origin, lastTime))
+		return false;
+	// ⛔ The queue is consumed strictly in order and a step that is not due yet BLOCKS the ones
+	// behind it. A live add is timed from NOW, so adding to a queue that still holds a step
+	// scheduled later would silently strand the new step behind it. Say so instead.
+	if (before > _scriptPos && _scriptSteps[before].time < _scriptSteps[before - 1].time) {
+		warning("script: `%s` lands at t=%u, behind a step already queued for t=%u -- "
+		        "`script clear` first", line.c_str(), (uint)_scriptSteps[before].time,
+		        (uint)_scriptSteps[before - 1].time);
+		_scriptSteps.resize(before);
+		return false;
+	}
+	if (_scriptSteps.size() > before)
+		debug("[script] added at t=%u (now t=%u, %u pending)",
+		      (uint)_scriptSteps[before].time, (uint)_fakeTimer, (uint)pendingScriptSteps());
+	return true;
+}
+
+bool EventRecorder::loadScript(const Common::String &path, bool replace) {
+	Common::FSNode node((Common::Path(path)));
+	Common::SeekableReadStream *stream = node.createReadStream();
+	if (!stream) {
+		warning("script: cannot read %s", path.c_str());
+		return false;
+	}
+
+	uint32 keptFrom = _scriptSteps.size();
+	if (replace) {
+		clearScript();
+		keptFrom = 0;
+	}
+	uint32 origin = _fakeTimer;
+	uint32 lastTime = origin;
+	int lineNo = 0;
+	bool ok = true;
+	while (!stream->eos()) {
+		Common::String line = stream->readLine();
+		lineNo++;
+		if (stream->err()) {
+			warning("script: read error in %s at line %d", path.c_str(), lineNo);
+			ok = false;
+			break;
+		}
+		if (!parseScriptLine(line, lineNo, origin, lastTime))
+			ok = false;
+	}
+	delete stream;
+
