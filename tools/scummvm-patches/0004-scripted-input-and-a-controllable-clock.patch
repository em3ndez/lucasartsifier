+	if (sub == "clock" && argc == 3) {
+		g_eventRec.setClockStep((uint32)atoi(argv[2]));
+		debugPrintf("clock step %s ms/query\n", argv[2]);
+	} else if (sub == "trace" && argc == 3) {
+		g_eventRec.setClockTrace((uint32)atoi(argv[2]));
+		debugPrintf("clock trace every %s ms\n", argv[2]);
+	} else if (sub == "clear") {
+		g_eventRec.clearScript();
+		debugPrintf("script cleared\n");
+	} else if (sub == "load" && argc == 3) {
+		debugPrintf("%s\n", g_eventRec.loadScript(argv[2]) ? "loaded" : "LOAD FAILED");
