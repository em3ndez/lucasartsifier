From: sierra_softlock playtest harness
Subject: [PATCH] sci: a workaround table for the List node-walk, with KQ5's eachElementDo in it

KQ5 walks a List holding a plain integer where a node belongs, so the node accessors are handed
`1`. ScummVM's signature-mismatch path ENTERS THE DEBUGGER, and this project's harness drives
that same debugger over a pipe -- so the session derails and ScummVM exits 1, with the error
scrolled far above the tail. Every death in the KQ5 lite suite is this one fault:

    ERROR:[kq5-1.000.052 34/999 sounds::eachElementDo @ 0311]:
    parameter 0: 0000:0001 (integer), should be null, node
    [VM] kNodeValue[36]: signature mismatch!

⛔ IT IS NOT ONE KERNEL CALL. The walk trips whichever accessor reaches the bad element first,
and which one that is varies per room -- kNodeValue from rm034 `sounds`, rm006 `Dialog` and
rm046 `timers`, but kNextNode from rm030 `sounds`. Fixing only kNodeValue left rm030 dying.
So ONE table is shared by the whole family: FirstNode, LastNode, NextNode, PrevNode, NodeValue.
All five had NO workaround table wired at all (a bare NULL), where DeleteKey and FindKey have
theirs.

ScummVM already tolerates this exact `List::eachElementDo` invalid-parameter bug for three other
games -- kIsObject_workarounds carries GK1 demo, Island of Dr Brain and QFG3.

The entry pins script 999 (the List class) and KQ5, but NOT an object name: `nullptr` matches
any (workarounds.cpp:1096), because the list differs per room.

⚠️ This makes the HARNESS tolerate a game script bug; it does not establish whether the state is
reachable in normal play, where a player on stock ScummVM would see the same error.
diff --git a/engines/sci/engine/kernel_tables.h b/engines/sci/engine/kernel_tables.h
index 32d131bf..53e69f74 100644
--- a/engines/sci/engine/kernel_tables.h
+++ b/engines/sci/engine/kernel_tables.h
@@ -707,7 +707,7 @@ static SciKernelMapEntry s_kernelMap[] = {
 	{ "FPuts", kFileIOWriteString, SIG_EVERYWHERE,           "ir",                    NULL,            NULL },
 	{ MAP_CALL(FileIO),            SIG_EVERYWHERE,           "i([.!]*)",              kFileIO_subops,  NULL },
 	{ MAP_CALL(FindKey),           SIG_EVERYWHERE,           "l.",                    NULL,            kFindKey_workarounds },
-	{ MAP_CALL(FirstNode),         SIG_EVERYWHERE,           "[l0]",                  NULL,            NULL },
+	{ MAP_CALL(FirstNode),         SIG_EVERYWHERE,           "[l0]",                  NULL,            kNodeWalk_workarounds },
 	{ MAP_CALL(FlushResources),    SIG_EVERYWHERE,           "i",                     NULL,            NULL },
 	{ MAP_CALL(Format),            SIG_EVERYWHERE,           "r[ri](.*)",             NULL,            NULL },
 	{ MAP_CALL(GameIsRestarting),  SIG_EVERYWHERE,           "(i)",                   NULL,            NULL },
@@ -744,7 +744,7 @@ static SciKernelMapEntry s_kernelMap[] = {
 	{ MAP_CALL(IsItSkip),          SIG_EVERYWHERE,           "iiiii",                 NULL,            NULL },
 	{ MAP_CALL(IsObject),          SIG_EVERYWHERE,           ".",                     NULL,            kIsObject_workarounds },
 	{ MAP_CALL(Joystick),          SIG_EVERYWHERE,           "i(.*)",                 NULL,            NULL }, // subop
-	{ MAP_CALL(LastNode),          SIG_EVERYWHERE,           "l",                     NULL,            NULL },
+	{ MAP_CALL(LastNode),          SIG_EVERYWHERE,           "l",                     NULL,            kNodeWalk_workarounds },
 	{ MAP_CALL(Load),              SIG_EVERYWHERE,           "ii(i*)",                NULL,            NULL },
 	{ MAP_CALL(LocalToGlobal),     SIG_SCI16, SIGFOR_ALL,    "o",                     NULL,            NULL },
 #ifdef ENABLE_SCI32
@@ -765,8 +765,8 @@ static SciKernelMapEntry s_kernelMap[] = {
 	{ MAP_CALL(NewWindow),         SIG_SCI0, SIGFOR_ALL,     "iiii[r0]i(i)(i)(i)",    NULL,            NULL },
 	{ MAP_CALL(NewWindow),         SIG_SCI1, SIGFOR_ALL,     "iiii[ir]i(i)(i)([ir])(i)(i)(i)(i)", NULL, NULL },
 	{ MAP_CALL(NewWindow),         SIG_SCI11, SIGFOR_ALL,    "iiiiiiii[r0]i(i)(i)(i)", NULL,           kNewWindow_workarounds },
-	{ MAP_CALL(NextNode),          SIG_EVERYWHERE,           "n",                     NULL,            NULL },
-	{ MAP_CALL(NodeValue),         SIG_EVERYWHERE,           "[n0]",                  NULL,            NULL },
+	{ MAP_CALL(NextNode),          SIG_EVERYWHERE,           "n",                     NULL,            kNodeWalk_workarounds },
+	{ MAP_CALL(NodeValue),         SIG_EVERYWHERE,           "[n0]",                  NULL,            kNodeWalk_workarounds },
 	{ MAP_CALL(NumCels),           SIG_EVERYWHERE,           "o",                     NULL,            NULL },
 	{ MAP_CALL(NumLoops),          SIG_EVERYWHERE,           "o",                     NULL,            NULL },
 	{ MAP_CALL(OnControl),         SIG_EVERYWHERE,           "ii(i)(i)(i)",           NULL,            NULL },
@@ -780,7 +780,7 @@ static SciKernelMapEntry s_kernelMap[] = {
 	{ "Platform", kPlatform32,     SIG_SCI32, SIGFOR_ALL,    "(i)",                   NULL,            kPlatform32_workarounds },
 #endif
 	{ MAP_CALL(Portrait),          SIG_EVERYWHERE,           "i(.*)",                 NULL,            NULL }, // subop
-	{ MAP_CALL(PrevNode),          SIG_EVERYWHERE,           "n",                     NULL,            NULL },
+	{ MAP_CALL(PrevNode),          SIG_EVERYWHERE,           "n",                     NULL,            kNodeWalk_workarounds },
 	{ MAP_CALL(PriCoord),          SIG_EVERYWHERE,           "i",                     NULL,            NULL },
 	{ MAP_CALL(Random),            SIG_EVERYWHERE,           "(i)(i)",                NULL,            kRandom_workarounds },
 	{ MAP_CALL(ReadNumber),        SIG_EVERYWHERE,           "r",                     NULL,            kReadNumber_workarounds },
diff --git a/engines/sci/engine/workarounds.cpp b/engines/sci/engine/workarounds.cpp
index 6c7b8ae9..33c5487e 100644
--- a/engines/sci/engine/workarounds.cpp
+++ b/engines/sci/engine/workarounds.cpp
@@ -932,6 +932,15 @@ const SciWorkaroundEntry kNewWindow_workarounds[] = {
 	SCI_WORKAROUNDENTRY_TERMINATOR
 };
 
+//    gameID,           room,script,lvl,          object-name, method-name, local-call-signature, index-range,   workaround
+// Shared by the whole node-accessor family -- FirstNode, LastNode, NextNode, PrevNode and
+// NodeValue -- because a List walk trips whichever of them reaches the bad element first, and
+// which one that is varies per room.
+const SciWorkaroundEntry kNodeWalk_workarounds[] = {
+	{ GID_KQ5,            -1,   999,  0,              nullptr, "eachElementDo",             nullptr,     0,     0, { WORKAROUND_FAKE, 0 } }, // KQ5 walks a List holding a plain integer where a node belongs, so the walk is handed 1 instead of a node. Seen as kNodeValue from rm034 `sounds`, rm006 `Dialog` and rm046 `timers`, and as kNextNode from rm030 `sounds` -- hence no object name is pinned. Same class of script bug as the kIsObject List::eachElementDo entries above.
+	SCI_WORKAROUNDENTRY_TERMINATOR
+};
+
 //    gameID,           room,script,lvl,          object-name, method-name, local-call-signature, index-range,   workaround
 const SciWorkaroundEntry kPalVarySetVary_workarounds[] = {
 	{ GID_KQ7,          4600,  4600,  0,      "sRosDogDeath",  "changeState",            nullptr,     0,     0, { WORKAROUND_IGNORE, 0 } }, // when dying under Malicia's house, gets called with no parameters (bug #9763)
